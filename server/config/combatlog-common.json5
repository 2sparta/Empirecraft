{
	// The amount of time in seconds a player should be in combat
	combatTime: 50,
	// Whether a player should be put in combat from just other players or all damage
	allDamage: false,
	// Whether a player should be put in combat from mobs
	mobDamage: false,
	// Whether a player should be put in combat from hurting themselves
	selfDamage: true,
	// Whether a player should be put in combat from targeted fire damage (fire aspect)
	fireDamage: true,
	// Whether a player should be able to use their elytra while in combat, this will not make them drop from the sky it simply restricts starting elytra flight
	disableElytra: false,
	// Whether a player should be able to use ender pearls in combat
	disablePearl: false,
	// This is a list of item ids to disable while in combat, use commas to separate them and leave empty to disable, only items that do something when right-clicked. example "minecraft:firework_rocket,minecraft:ender_pearl,minecraft:water_bucket"
	disabledItems: "",
	// This is a list of block ids to disable while in combat, use commas to separate them and leave empty to disable, only blocks that do something when right-clicked. example "minecraft:chest,minecraft:oak_door,waystones:waystone"
	disabledBlocks: "",
	// The death message that shows when a player disconnects while in combat, use {player} to autofill their name
	deathMessage: "самоубился",
	// Whether a player should get a popup when they enter combat or when trying to run blocked commands
	combatNotice: true,
	// Whether the combat notice should appear above the hotbar or as a bossbar use "hotbar" or "bossbar"
	noticeType: "hotbar",
	// The message that shows when a player is in combat, adding {timeLeft} will display how many seconds until combat is over
	inCombat: "Ты в состояние боя, не пытайся ливнуть, {timeLeft} секунд осталось",
	// The message that shows when a player exits combat
	outCombat: "Ты больше не в битве",
	// This is a list of commands to be blocked while in combat, do not include the slash and use commas to separate them, leave empty to disable, example "home,spawn,rtp"
	blockedCommands: "home,spawn,warp,tpa,tpaccept,tpdeny,tpahere,tpacancel,back,rtp,kit,essentials:home,essentials:spawn,essentials:warp,essentials:tpa,essentials:tpaccept,essentials:tpdeny,towny:spawn,towny:home,towny:outpost,towny:warp,t,towny,logout,leave,menu,t spawn,town spawn",
	// This is the message displayed in chat when a player attempts to use a blocked command
	blockedCommandMessage: "ты в боевом режиме",
	// This is the message displayed in chat when a player attempts to use a block
	disabledBlocksMessage: "You are in combat and cannot use this",
	// This determines if disconnecting while tagged kills the player
	disconnectKill: true,
	// This determines if the last person to attack or the person with the most damage gets credit, use "time" or "damage"
	attackerCredit: "time",
	// This is a command to be run when a tagged player disconnects, use {player} and {attacker} to autofill their names, leave blank to disable, example "warn {player} combatlogging"
	disconnectCommand: "",
	// This is a command to be run when a player is put into combat, use {player} to autofill their name, and {tagTime} for the duration of combat, runs on BOTH players every time they take damage NOT just the start, leave blank to disable, example "effect give {player} glowing {tagtime} "
	combatCommand: ""
}